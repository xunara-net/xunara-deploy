# docker compose 环境文件（chmod 600）。带 XUNARA_ 前缀的变量会被 compose 展开，
# 同名的 secret 由 server 容器的 env_file 读取。
#
# 控制面对外基址：必须与浏览器访问的地址一致，否则登录回调与 Cookie 域会错位。
XUNARA_SERVER_URL=http://localhost
# 客户端拨号用的中继名/IP，必须是公网可达地址。
XUNARA_DERP_HOST=localhost
XUNARA_VERSION=latest
XUNARA_HTTP_PORT=80
XUNARA_DERP_PORT=9091
XUNARA_TIMEZONE=Asia/Shanghai
XUNARA_LOG_LEVEL=info
# WebAuthn 需要 https 或 localhost；纯 IP 部署保持 false。
XUNARA_PASSKEY=false

# ---- secret 示例（按需取消注释；不要提交真实值）----
#XUNARA_OIDC_CLIENT_SECRET=
#XUNARA_PLATFORM_ADMIN_TOKEN=
#XUNARA_WEBHOOK_SECRET=
#XUNARA_DNS_WEBHOOK_TOKEN=
#XUNARA_CLOUDFLARE_API_TOKEN=
