[Unit]
Description=Xunara control plane (xunarad)
Documentation=https://github.com/xunara-net/xunara-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xunara
Group=xunara
WorkingDirectory=/var/lib/xunara

# Secrets belong here, mode 0600: OIDC/OAuth2 client secret, platform admin token,
# webhook signing secret, DNS webhook token. They must never sit on the
# command line, where every local user can read them from `ps`.
EnvironmentFile=-/etc/xunara/xunarad.env

# State and its ownership are managed by systemd; the flags below are the
# deployment's public surface, so edit them here rather than in a shell script.
StateDirectory=xunara
StateDirectoryMode=0700
# Ports: 9090 is this HTTP API (home, console, client login). The public 9091
# belongs to the relay (deploy/systemd/xunara-relay.service); the platform gRPC
# API stays private because it is meant to be reachable only from the host or a
# firewall allowlist.
ExecStart=/opt/xunara/bin/xunarad \
    -listen @XUNARA_LISTEN@ \
    @XUNARA_TENANT_ARGS@ \
    -grpc-listen @XUNARA_GRPC_LISTEN@ \
    -console-timezone Asia/Shanghai \
    -log-level info \
    -trusted-proxy=@XUNARA_TRUSTED_PROXY@ \
    @XUNARA_EXTRA_ARGS@

Restart=on-failure
RestartSec=2s

# The control plane owns one directory and no other part of the host.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
